rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Email verification codes are managed exclusively by Cloud Functions
    // (which use the Admin SDK and bypass these rules). The browser must
    // NOT read or write these documents directly.
    match /emailVerificationCodes/{email} {
      allow read, write: if false;
    }

    // Abuse-prevention counters are also server-only.
    match /verificationRate/{key} {
      allow read, write: if false;
    }

    // Public product and category reads; writes restricted to admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: allow creation by any client (guest or authenticated).
    // Reading/updating orders restricted: users can read their own orders,
    // admins can read/update all orders.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.customer != null && resource.data.customer.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admins collection — only admins can read/write
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users profiles: users can read/write their own profile
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
  }
}
